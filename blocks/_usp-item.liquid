{%- liquid
  assign usp_text = block.settings.text | strip
  assign usp_icon = block.settings.icon
-%}

{%- if usp_text != blank or usp_icon != 'none' -%}
  {%- capture usp_content -%}
    {%- render 'icon-or-image', icon: usp_icon, image_upload: block.settings.image_upload, width: 16, class_name: 'header-topbar__usp-icon' -%}
    {%- if usp_text != blank -%}
      <span class="header-topbar__usp-text">{{ usp_text | escape }}</span>
    {%- endif -%}
  {%- endcapture -%}

  {%- if block.settings.link != blank -%}
    <a
      href="{{ block.settings.link }}"
      class="header-topbar__usp header-topbar__usp--link"
      {{ block.shopify_attributes }}
    >
      {{- usp_content -}}
    </a>
  {%- else -%}
    <div
      class="header-topbar__usp"
      {{ block.shopify_attributes }}
    >
      {{- usp_content -}}
    </div>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .header-topbar__usp {
    /* Selling points sit before the shortcut links, whatever the block order is */
    order: 1;
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--gap-2xs);
    color: var(--color-foreground);
    text-decoration: none;
  }

  .header-topbar__usp--link:hover .header-topbar__usp-text {
    text-decoration: underline;
    text-underline-offset: var(--padding-2xs);
  }

  .header-topbar__usp-icon {
    flex-shrink: 0;
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }
{% endstylesheet %}

